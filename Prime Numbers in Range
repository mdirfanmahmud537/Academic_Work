#include <stdio.h>
int main() {
    int start = 10, end = 30, i, j, isPrime;
    for (i = start; i <= end; i++) {
        if (i <= 1) continue;
        isPrime = 1;
        for (j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                isPrime = 0;
                break;
            }
        }
        if (isPrime)
            printf("%d ", i);
    }
    return 0;
}
